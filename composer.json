{
    "name": "psyao/kami",
    "description": "A Laravel and Filament CMS for developers, at home on shared hosting.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "cms"
    ],
    "homepage": "https://github.com/psyao/kami",
    "support": {
        "issues": "https://github.com/psyao/kami/issues",
        "source": "https://github.com/psyao/kami"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Steve Aguet",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "filament/filament": "^5",
        "laravel/framework": "^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Psyao\\Kami\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Psyao\\Kami\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Psyao\\Kami\\KamiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
