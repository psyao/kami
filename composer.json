{
    "name": "psyao/kami",
    "description": "Psyao Kami: a Laravel and Filament CMS for developers, at home on shared hosting.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "cms"
    ],
    "homepage": "https://github.com/psyao/kami",
    "support": {
        "issues": "https://github.com/psyao/kami/issues",
        "source": "https://github.com/psyao/kami"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Steve Aguet",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.8.3",
        "laravel/framework": "^13.32",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "evilmartians/lefthook": "^2.2",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Psyao\\Kami\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Psyao\\Kami\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi",
            "lefthook install",
            "@link-skills"
        ],
        "link-skills": "mkdir -p .claude/skills && for d in vendor/*/*/resources/boost/skills/*/ resources/boost/skills/*/; do [ -d \"$d\" ] && ln -sfn \"../../$d\" .claude/skills/$(basename \"$d\"); done; true",
        "analyse": "phpstan analyse",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench package:discover --ansi",
            "pest --testsuite=Kami --parallel",
            "pest --testsuite=Install"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench package:discover --ansi",
            "pest --testsuite=Kami,Install --coverage --min=90"
        ],
        "reference": [
            "@php vendor/bin/testbench package:discover --ansi",
            "@putenv KAMI_REFERENCE=write",
            "pest tests/Kami/PublicSurfaceTest.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Psyao\\Kami\\KamiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
