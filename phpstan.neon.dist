includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

# No baseline. An `ignoreErrors` entry names its identifier and path, with a comment saying why.
# `routes` joins the paths with its first file: PHPStan fails on a missing path.
parameters:
    level: max
    paths:
        - config
        - database
        - resources/page-cache.php
        - src
        - workbench/app
        - workbench/database
    checkModelProperties: true
    ignoreErrors:
        # A type's view is the site's, named by convention at run time (ADR 0009): no view-string can be known statically.
        -
            identifier: argument.type
            path: src/Content/ContentType.php
            message: '#expects view-string, string given#'
        # Larastan boots Testbench without discovering this package, so it knows none of the `kami::` views its provider registers;
        # a local package manifest that lists it hides the error, hence unmatched is not reported.
        -
            identifier: argument.type
            path: src/Admin/Internal/EntryResource/EditEntry.php
            message: '#expects view-string\|null, string given#'
            reportUnmatched: false
    # The package's own config, not Testbench's skeleton: `env()` belongs there.
    configDirectories:
        - %currentWorkingDirectory%/config
